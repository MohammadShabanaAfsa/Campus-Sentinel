# ─── Copy this to .env and fill in your values ───────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Campus Sentinel
ENVIRONMENT=development
DEBUG=false

# ─── Security (generate with: openssl rand -hex 32) ─────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=campus_sentinel
POSTGRES_USER=cs_admin
POSTGRES_PASSWORD=cs_secure_pass_2024

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cs_redis_pass
REDIS_DB=0

# ─── AI Engine ───────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=models/weights/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_DEVICE=cpu
# Set to "cuda" if you have an Nvidia GPU:
# YOLO_DEVICE=cuda

FRAME_SKIP=3
MAX_CAMERAS=16

# ─── Camera Source (Android IP Webcam, with local-webcam fallback) ──────────
IP_CAMERA_URL=http://10.179.77.183:8080/video
CAMERA_FALLBACK_INDEX=0
CAMERA_RECONNECT_DELAY_SECS=5.0

# ─── Behavioral Thresholds ───────────────────────────────────────────────────
LOITERING_THRESHOLD_SECS=300
CROWD_DENSITY_THRESHOLD=20
RUNNING_SPEED_THRESHOLD=3.0

# ─── Alert Settings ───────────────────────────────────────────────────────────
ALERT_COOLDOWN_SECS=60
THREAT_ALERT_THRESHOLD=0.5

# ─── Email / FastAPI-Mail (optional) ─────────────────────────────────────────
# Leave MAIL_USERNAME blank to disable email (uses mock logging instead)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=alerts@localhost
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
FRONTEND_URL=http://localhost:3000

# ─── Monitoring ──────────────────────────────────────────────────────────────

# ─── Frontend ────────────────────────────────────────────────────────────────
# Frontend environment variables belong in the frontend project, not the backend .env

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
