# ─── Copy this to .env and fill in your values ───────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Campus Sentinel
ENVIRONMENT=development
DEBUG=false

# ─── Security (generate with: openssl rand -hex 32) ─────────────────────────
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_BEFORE_USE

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=campus_sentinel
POSTGRES_USER=cs_admin
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ─── AI Engine ───────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_DEVICE=cpu
# Set to "cuda" if you have an Nvidia GPU:
# YOLO_DEVICE=cuda

FRAME_SKIP=3
MAX_CAMERAS=16

# ─── Camera Source (Android IP Webcam, with local-webcam fallback) ──────────
# First-time seed only. Set the reachable URL shown by Android IP Webcam.
# Example format: http://<PHONE_IP>:8080/video
IP_CAMERA_URL=
CAMERA_FALLBACK_INDEX=0
CAMERA_RECONNECT_DELAY_SECS=5.0

# Explicit QR identification. Workbook is read once; restart backend to reload.
QR_IDENTIFICATION_ENABLED=true
STUDENT_QR_WORKBOOK=student_face_list.xlsx
QR_SCAN_INTERVAL_SECS=1.0
# Identity persists while its track is visible; clear after this disappearance grace.
QR_TRACK_GRACE_SECS=3.0
QR_ASSOC_MAX_DISTANCE_FRACTION=0.08
QR_ASSOC_AMBIGUITY_MARGIN_FRACTION=0.03
# Temporary debugging: use QR_SCAN_INTERVAL_SECS=0.25 and enable these flags.
QR_ASSOCIATION_MARGIN_PX=40
QR_DEBUG_LOGGING=false
QR_DEBUG_OVERLAY=false
QR_SCAN_TIMEOUT_SECS=2.0

# ─── Behavioral Thresholds ───────────────────────────────────────────────────
LOITERING_THRESHOLD_SECS=300
LOITERING_TRACK_GRACE_SECS=3.0
LOITERING_MOVEMENT_RADIUS=0.05
# Test-only duration; ignored unless ACTIVITY_DEBUG=true. Never changes production duration.
LOITERING_DEBUG_THRESHOLD_SECS=10
CROWD_DENSITY_THRESHOLD=5
CROWD_SURGE_WINDOW_SECS=30
CROWD_SURGE_GROWTH_THRESHOLD=0.50
CROWD_SURGE_BASELINE_SECS=5
CROWD_SURGE_CONFIRM_SECS=3
CROWD_SURGE_MIN_SAMPLES=3
CROWD_EPISODE_CLEAR_SECS=3
CROWD_MAX_SAMPLE_GAP_SECS=5
RUNNING_SPEED_THRESHOLD=3.0

# Person activities: normalized distances use visible shoulder width.
ACTIVITY_ANALYSIS_INTERVAL_SECS=0.75
ACTIVITY_DEBUG=false
# Fall-only settings; existing person activity thresholds are unchanged.
FALL_ANGLE_THRESHOLD=60
FALL_PERSISTENCE_SECS=4
FALL_RECOVERY_SECS=2
# Independent unusual campus events. Test bag duration applies only in debug mode.
FIGHT_PERSISTENCE_SECS=4
FIGHT_CLEAR_SECS=3
FIGHT_PROXIMITY_RADIUS=0.15
FIGHT_RELATIVE_SPEED=0.10
FIGHT_ARM_SPEED=0.70
ABANDONED_BAG_SECS=45
ABANDONED_BAG_TEST_SECS=5
BAG_OWNER_RADIUS=0.18
BAG_STATIONARY_RADIUS=0.02
AFTER_HOURS_CONFIRM_SECS=2
EXIT_BLOCKAGE_SECS=10
ENABLE_ACTIVITY_ANALYSIS_ON_GENERAL=true
PHONE_USE_MIN_DURATION_SECS=2.0
PHONE_USE_MIN_HITS=3
PHONE_USE_CLEAR_TIMEOUT_SECS=1.5
PHONE_PERSON_ASSOCIATION_MARGIN=20
PHONE_HAND_DISTANCE_THRESHOLD=0.45
EATING_MIN_EVENTS=3
EATING_LIMB_CROP_PADDING=0.35
EATING_WRIST_VISIBILITY_THRESHOLD=0.50
EATING_LANDMARK_GRACE_SECS=1.5
EATING_MAX_LANDMARK_GRACE_SECS=3.0  # Bounded allowance for one missed slower activity sample.
PHONE_EATING_DEBUG=false
EATING_WINDOW_SECS=20
EATING_CLEAR_TIMEOUT_SECS=6
EATING_MOUTH_DISTANCE_THRESHOLD=0.70
EATING_AWAY_DISTANCE_THRESHOLD=0.85
EATING_MIN_NEAR_SECS=0.25
EATING_MAX_NEAR_SECS=3
EATING_MIN_EVENT_INTERVAL_SECS=1

# ─── Alert Settings ───────────────────────────────────────────────────────────
ALERT_COOLDOWN_SECS=60
THREAT_ALERT_THRESHOLD=0.5

# ─── Email / FastAPI-Mail (optional) ─────────────────────────────────────────
# Leave MAIL_USERNAME blank to disable email (uses mock logging instead)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=alerts@localhost
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
FRONTEND_URL=http://localhost:3000

# ─── Monitoring ──────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

NEXT_PUBLIC_CAMPUS_LAT=17.3545464

NEXT_PUBLIC_CAMPUS_LNG=78.5934475

NEXT_PUBLIC_CAMPUS_ZOOM=18

# Detector input repair; General talking threshold requires local calibration.
ACTIVITY_TRACK_GRACE_SECS=3.0
SLEEPING_LANDMARK_GRACE_SECS=3.0
TALKING_MAR_STD_THRESHOLD=0.035
# GENERAL_TALKING_MAR_STD_THRESHOLD=0.035
YOLO_PHONE_CONFIDENCE_THRESHOLD=0.25
PHONE_ROI_INFERENCE_ENABLED=true
PHONE_ROI_MAX_PERSONS=2
PHONE_ROI_MAX_INPUT_SIZE=960
ACTIVITY_POSE_CROP_PADDING=0.20

# Confirmed behavior pipeline
SLEEP_EAR_THRESHOLD=0.20
# GENERAL_SLEEP_EAR_THRESHOLD=0.284903  # requires per-camera eye calibration
BEHAVIOR_ANALYSIS_INTERVAL_SECS=0.75
RUNNING_SPEED_THRESHOLD_PX_SEC=120
RUNNING_MIN_CONSECUTIVE_SAMPLES=3
RUNNING_MIN_DURATION_SECS=1.5
RUNNING_MIN_DISPLACEMENT_PX=80
ACCELERATION_MIN_BASE_SPEED_PX_SEC=25
ACCELERATION_MIN_DELTA_PX_SEC=80
ACCELERATION_RATIO=3
EATING_TEST_MIN_CYCLES=1  # diagnostic-only; does not change production confirmation
EATING_DEBUG=false  # Eating-only log diagnostics; never draws a debug panel.

RESTRICTED_ZONE_FOOT_TOLERANCE=0.05

RESTRICTED_ZONE_REFERENCE_POINT=FOOT_POINT

RESTRICTED_ZONE_MIN_OVERLAP_RATIO=0.05
